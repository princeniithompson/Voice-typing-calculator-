# GEMINI_API_KEY: Required for Gemini Live transcription.
# AI Studio replaces this placeholder from the Secrets panel when the line is present.
# If the line is commented out, the secrets plugin does not package a key into the APK.
# The app rejects this placeholder at runtime until a real key is injected or saved in Settings.
GEMINI_API_KEY=MY_GEMINI_API_KEY
